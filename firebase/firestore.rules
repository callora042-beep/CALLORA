rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /calls/{callId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.providerId);
      // Writes to live call fields (chosenReply, mode) are allowed by the two participants;
      // the relay server writes with an admin SDK service account, which bypasses these rules.
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.providerId);
      allow create: if request.auth != null;
    }

  }
}
