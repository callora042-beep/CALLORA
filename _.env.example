# Copy this file to .env and fill in real values.
# Netlify: add these under Site settings → Environment variables.
# Relay server (Railway/Render): add the ones marked [relay] there too.

# Firebase
FIREBASE_SERVICE_ACCOUNT=            # full service account JSON, as one line

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RELAY_SERVER_WS_URL=                 # [relay] wss://your-relay.up.railway.app

# ElevenLabs
ELEVENLABS_API_KEY=

# Deepgram [relay]
DEEPGRAM_API_KEY=

# Claude API [relay]
ANTHROPIC_API_KEY=

